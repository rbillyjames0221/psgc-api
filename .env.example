# Copy to .env.local (never commit real values).

# MAIN database: the ONLY database the public API reads from (approved releases).
DATABASE_URL_MAIN=postgresql://USER:PASSWORD@HOST/main?sslmode=require
# STAGING database: every new PSA import lands here first and waits for approval.
DATABASE_URL_STAGING=postgresql://USER:PASSWORD@HOST/staging?sslmode=require

# Secret for the /admin/review login and for signing review links (HMAC-SHA256). Use 32+ random bytes:
#   openssl rand -hex 32
ADMIN_SECRET=change-me-to-a-long-random-string

# Public URL of this app, used to build review links printed by `npm run stage` / `npm run diff`.
PUBLIC_BASE_URL=http://localhost:3000

# Optional
# REVIEW_LINK_TTL_DAYS=14
# GUARD_MAX_DROP_PCT=1
# PG_POOL_MAX=5
